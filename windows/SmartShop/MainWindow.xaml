<Window x:Class="SmartShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:SmartShop.Components"
        Title="SmartShop AI" Height="720" Width="520"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8" VerticalAlignment="Center">
            <TextBlock Text="SmartShop AI 智能导购" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
            <Button Content="🌙" Width="32" Height="28" Margin="12,0,0,0" Background="Transparent"
                    BorderThickness="0" FontSize="14" Cursor="Hand"
                    Click="ThemeBtn_Click" ToolTip="切换深色/浅色模式"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
            <DockPanel>
                <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="发送"
                        Width="80" Height="40" Margin="8,0,0,0"
                        Click="SendBtn_Click"/>
                <Button x:Name="ImageBtn" DockPanel.Dock="Right" Content="图片"
                        Width="56" Height="40" Margin="4,0,0,0"
                        Click="ImageBtn_Click"/>
                <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Center" MinHeight="40" MaxHeight="120"
                         FontSize="14" PreviewKeyDown="InputBox_KeyDown"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         PreviewMouseWheel="InputBox_PreviewMouseWheel"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MsgScroll" Margin="12,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,6" CornerRadius="10" MaxWidth="400">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AssistantBubbleBrush}"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="20"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.25"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="20" To="0" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Image Source="{Binding Image}" MaxHeight="200" MaxWidth="340"
                                       Stretch="Uniform" Margin="0,0,0,8"
                                       HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="14" LineHeight="22" MaxWidth="360"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="▌" FontSize="14" Foreground="#4A90D9"
                                               VerticalAlignment="Bottom" Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.2" Duration="0:0:0.4"
                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:ProductCard/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="👍" Width="32" Height="26" Margin="0,0,6,0"
                                            FontSize="13" Click="LikeBtn_Click" Tag="{Binding}"/>
                                    <Button Content="👎" Width="32" Height="26"
                                            FontSize="13" Click="DislikeBtn_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
