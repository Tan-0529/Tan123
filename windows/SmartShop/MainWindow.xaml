<Window x:Class="SmartShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:SmartShop.Components"
        Title="SmartShop AI" Height="720" Width="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8" VerticalAlignment="Center">
            <TextBlock Text="SmartShop AI 智能导购" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12">
            <DockPanel>
                <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="发送"
                        Width="80" Height="40" Margin="8,0,0,0"
                        Click="SendBtn_Click"/>
                <Button x:Name="ImageBtn" DockPanel.Dock="Right" Content="图片"
                        Width="56" Height="40" Margin="4,0,0,0"
                        Click="ImageBtn_Click"/>
                <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Center" MinHeight="40" MaxHeight="120"
                         FontSize="14" KeyDown="InputBox_KeyDown"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MsgScroll" Margin="12,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,6" CornerRadius="10" MaxWidth="400">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F2F3F5"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="Background" Value="#D6EAF8"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Image Source="{Binding Image}" MaxHeight="200" MaxWidth="340"
                                       Stretch="Uniform" Margin="0,0,0,8"
                                       HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           FontSize="14" LineHeight="22"/>
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:ProductCard/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
